# ------------------------------------------------------------------
# Environment Configuration Template
# ------------------------------------------------------------------
#
# This file provides a template for the environment variables
# required to run the application.
#
# Purpose
# -------
# - Define required configuration values
# - Serve as a reference for developers and deployment environments
# - Provide safe placeholders instead of real secrets
#
# Usage
# -----
# 1. Copy this file to a new `.env` file:
#       cp .env.example .env
#
# 2. Replace placeholder values with real configuration values
#    appropriate for your environment.
#
# Security Notice
# ---------------
# The `.env` file should never be committed to version control.
# Only `.env.example` should remain in the repository.
# ------------------------------------------------------------------


# ------------------------------------------------------------------
# Project Settings
# ------------------------------------------------------------------
# Human-readable name of the application used in documentation,
# logs, and API metadata.
PROJECT_NAME=FastAPI Task Manager


# ------------------------------------------------------------------
# Database Configuration
# ------------------------------------------------------------------
# Database connection string used by SQLAlchemy.
#
# Format:
#   postgresql://username:password@host:port/database_name
#
# Example:
#   postgresql://postgres:postgres@localhost:5432/task_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/task_db


# ------------------------------------------------------------------
# Security Configuration
# ------------------------------------------------------------------
# Secret key used for cryptographic operations such as
# signing and verifying JWT tokens.
#
# It is strongly recommended to generate a secure random key.
#
# Example command:
#   openssl rand -hex 32
SECRET_KEY=your-super-secret-key-placeholder


# ------------------------------------------------------------------
# JWT Configuration
# ------------------------------------------------------------------
# Algorithm used for signing JSON Web Tokens.
ALGORITHM=HS256

# Lifetime of access tokens in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------------
# Logging Configuration (Optional)
# ------------------------------------------------------------------
# Defines the minimum logging level for the application.
#
# Common values:
#   DEBUG
#   INFO
#   WARNING
#   ERROR
#   CRITICAL
LOG_LEVEL=INFO
