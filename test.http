@baseUrl = http://127.0.0.1:8000
@taskId = 1

### Health
GET {{baseUrl}}/health

### Register a disposable account
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "username": "local-example",
  "email": "local-example@example.org",
  "password": "synthetic-local-example-password"
}

### Sign in and configure accessToken and refreshToken in your HTTP client's private environment
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "identifier": "local-example@example.org",
  "password": "synthetic-local-example-password"
}

### Refresh access
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{"refresh_token": "{{refreshToken}}"}

### Create a task
POST {{baseUrl}}/tasks/
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"title": "Verify local release", "due_date": "2026-11-18T15:30:00+03:30"}

### List the caller's tasks
GET {{baseUrl}}/tasks/?sort_by=created_at&sort_order=desc
Authorization: Bearer {{accessToken}}

### Read one task
GET {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}

### Update one task
PUT {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{"is_completed": true}

### Delete one task
DELETE {{baseUrl}}/tasks/{{taskId}}
Authorization: Bearer {{accessToken}}
